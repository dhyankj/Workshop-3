---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <a href="/" class="text-sm text-blue-400 underline hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500" data-testid="clear-filters">Clear filters</a>
      </div>

      <form action="/" method="get" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5" data-testid="game-filters">
        <fieldset>
          <legend class="mb-3 text-lg font-medium text-slate-100">Filter games</legend>
          <div class="grid gap-5 md:grid-cols-2">
            <div>
              <span class="mb-2 block text-sm font-medium text-slate-300">Categories</span>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label class="inline-flex items-center gap-2 text-sm text-slate-200">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-600 focus:ring-2 focus:ring-blue-500"
                      data-testid={`category-filter-${category.id}`}
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </div>
            <div>
              <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-300">Publisher</label>
              <select id="publisher-filter" name="publisher" class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none" data-testid="publisher-filter">
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>
          </div>
          <button type="submit" class="mt-5 rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:outline-none" data-testid="apply-filters">Apply filters</button>
        </fieldset>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const categories = new Set(params.getAll('category'));
  const publisher = params.get('publisher') ?? '';
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const categoryInputs = document.querySelectorAll<HTMLInputElement>('input[name="category"]');
  const publisherSelect = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  categoryInputs.forEach((input) => {
    input.checked = categories.has(input.value);
  });
  if (publisherSelect) {
    publisherSelect.value = publisher;
  }

  const hasFilters = categories.size > 0 || publisher !== '';
  const visibleCards = cards.filter((card) => {
    const categoryMatches = categories.size === 0 || categories.has(card.dataset.gameCategoryId ?? '');
    const publisherMatches = publisher === '' || card.dataset.gamePublisherId === publisher;
    const visible = categoryMatches && publisherMatches;
    card.classList.toggle('hidden', !visible);
    return visible;
  });

  if (emptyState && hasFilters && visibleCards.length === 0) {
    emptyState.classList.remove('hidden');
  }
</script>
